      <form action="https://formspree.io/f/mkgdbnva" method="POST" class="calc">
        <div class="row">
          <div>
            <label for="name">Full Name</label>
            <input id="name" name="name" autocomplete="name" required placeholder="John Smith" />
          </div>
          <div>
