<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>New Jersey Electric Rate Increases → Lock In a 0% Solar PPA | Sunrun</title>
  <meta name="description" content="AC Electric & PSE&G customers: understand recent rate increases and see how a 0% escalator solar PPA can protect part of your bill. Book a free solar project review." />
  <style>
    :root{
      --bg: #f7f9fc;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #475569;
      --line: rgba(15,23,42,.12);
      --accent: #1d4ed8;
      --accent2:#22c55e;
      --warn:#f59e0b;
      --shadow: 0 10px 30px rgba(2,6,23,.08);
      --radius: 18px;
      --max: 1120px;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      background:
        radial-gradient(900px 500px at 15% 10%, rgba(29,78,216,.10), transparent 55%),
        radial-gradient(800px 480px at 90% 10%, rgba(34,197,94,.10), transparent 52%),
        linear-gradient(180deg, #ffffff 0%, var(--bg) 100%);
      color: var(--text);
      line-height: 1.45;
    }
    a{color:var(--accent); text-decoration:none}
    a:hover{text-decoration:underline}
    .wrap{max-width:var(--max); margin:0 auto; padding:24px}
    .topbar{
      display:flex; align-items:center; justify-content:space-between;
      gap:16px; padding:10px 0 22px;
    }
    .brand{
      display:flex; align-items:center; gap:12px;
      font-weight:800; letter-spacing:.2px;
    }
    .logo{
      width:44px; height:44px; border-radius:14px;
      background: conic-gradient(from 210deg, var(--accent), #60a5fa, var(--accent2));
      box-shadow: var(--shadow);
    }
    .brand small{display:block; font-weight:600; color:var(--muted); letter-spacing:0}
    .ctaRow{display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end}
    .btn{
      appearance:none; border:1px solid var(--line); background:var(--card);
      padding:10px 14px; border-radius:999px; font-weight:700;
      box-shadow: 0 1px 0 rgba(2,6,23,.04);
      display:inline-flex; align-items:center; gap:10px;
    }
    .btn.primary{
      background: linear-gradient(135deg, var(--accent), #2563eb);
      color:#fff; border-color: transparent;
      box-shadow: 0 12px 28px rgba(29,78,216,.25);
    }
    .btn.primary:hover{filter:brightness(1.03)}
    .btn:hover{transform: translateY(-1px); transition:.15s ease}
    .hero{
      display:grid; grid-template-columns: 1.25fr .75fr; gap:18px;
      align-items:stretch;
    }
    @media (max-width: 920px){
      .hero{grid-template-columns:1fr}
      .ctaRow{justify-content:flex-start}
    }
    .card{
      background:var(--card);
      border:1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding:20px;
    }
    .kicker{
      display:inline-flex; align-items:center; gap:8px;
      font-weight:800; color: #0b2a6b;
      background: rgba(29,78,216,.08);
      border:1px solid rgba(29,78,216,.18);
      padding:6px 10px; border-radius:999px;
      margin-bottom:12px;
    }
    .kdot{width:8px; height:8px; border-radius:99px; background:var(--accent)}
    h1{margin:0 0 10px; font-size: clamp(26px, 3.2vw, 40px); line-height:1.08}
    .sub{color:var(--muted); font-size: 1.05rem; margin:0 0 18px}
    .grid3{
      display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; margin-top:16px;
    }
    @media (max-width: 920px){ .grid3{grid-template-columns:1fr} }
    .pill{
      border:1px dashed rgba(15,23,42,.20);
      padding:12px 12px;
      border-radius: 16px;
      background: linear-gradient(180deg, rgba(2,6,23,.02), rgba(2,6,23,0));
    }
    .pill b{display:block; margin-bottom:3px}
    .badge{
      display:inline-flex; align-items:center; gap:8px;
      padding:8px 10px; border-radius: 14px;
      border:1px solid rgba(245,158,11,.28);
      background: rgba(245,158,11,.10);
      font-weight:800;
    }
    .promo{
      border:1px solid rgba(34,197,94,.28);
      background: linear-gradient(180deg, rgba(34,197,94,.10), rgba(34,197,94,.04));
    }
    .promo h3{margin:0 0 8px}
    .muted{color:var(--muted)}
    .section{
      margin-top:18px;
      display:grid; grid-template-columns: 1fr 1fr; gap:18px;
    }
    @media (max-width: 920px){ .section{grid-template-columns:1fr} }
    .list{
      margin: 10px 0 0;
      padding:0; list-style:none;
      display:grid; gap:10px;
    }
    .li{
      display:flex; gap:12px; align-items:flex-start;
      padding:12px; border-radius: 16px;
      border:1px solid var(--line);
      background: rgba(2,6,23,.02);
    }
    .icon{
      width:34px; height:34px; border-radius: 12px;
      display:grid; place-items:center; flex:0 0 auto;
      background: rgba(29,78,216,.10);
      border:1px solid rgba(29,78,216,.18);
      color: var(--accent);
      font-weight:900;
    }
    .calc{
      display:grid; gap:12px;
    }
    .calc .row{display:grid; grid-template-columns:1fr 1fr; gap:12px}
    @media (max-width: 520px){ .calc .row{grid-template-columns:1fr} }
    label{font-weight:800; font-size:.92rem}
    input, select, textarea{
      width:100%;
      padding:12px 12px;
      border-radius: 14px;
      border:1px solid var(--line);
      background:#fff;
      font-size: 1rem;
      outline:none;
    }
    input:focus, select:focus, textarea:focus{
      border-color: rgba(29,78,216,.55);
      box-shadow: 0 0 0 4px rgba(29,78,216,.10);
    }
    .note{
      font-size:.9rem; color:var(--muted);
      border-left: 4px solid rgba(29,78,216,.30);
      padding-left:12px;
    }
    .ppaBox{
      border:1px solid rgba(29,78,216,.22);
      background: linear-gradient(180deg, rgba(29,78,216,.08), rgba(29,78,216,.02));
    }
    .table{
      width:100%;
      border-collapse:separate;
      border-spacing:0;
      overflow:hidden;
      border-radius: 16px;
      border:1px solid var(--line);
      background:#fff;
    }
    .table th, .table td{
      padding:12px 12px;
      border-bottom:1px solid var(--line);
      text-align:left;
      font-size:.95rem;
    }
    .table th{background: rgba(2,6,23,.03); font-weight:900}
    .table tr:last-child td{border-bottom:none}
    .review{
      display:grid; gap:12px;
    }
    blockquote{
      margin:0;
      padding:16px;
      border-radius: 16px;
      border:1px solid var(--line);
      background: rgba(2,6,23,.02);
    }
    .stars{letter-spacing:2px}
    .footer{
      margin:22px 0 10px;
      display:flex; flex-wrap:wrap; gap:10px;
      justify-content:space-between; align-items:center;
      color:var(--muted);
      font-size:.92rem;
    }
    .fineprint{
      margin-top:10px; font-size:.85rem; color:var(--muted);
      border-top:1px solid var(--line); padding-top:12px;
    }
    .anchor{scroll-margin-top:16px}
  </style>
</head>

